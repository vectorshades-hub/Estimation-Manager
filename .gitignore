.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / cache
pids/
*.pid
*.seed
.npm/
.eslintcache
.cache/
*.tsbuildinfo

# Build / coverage output
dist/
build/
coverage/
.nyc_output/

# Local uploads and generated exports
uploads/
tmp/
temp/
*.tmp


MONGODB_URI=mongodb://127.0.0.1:27017/estimation_manager
PORT=3000

# Sign-in: false = no login, everyone has full access. Set to true to require login with user roles.
AUTH_ENABLED=true

# Backups (Backups page, Admin). Automatic backup every Sunday 6:00 AM (server time).
# Folder for backup files (default: backups/db inside the app folder). Best on another drive or a synced folder.
# BACKUP_DIR=D:\EstimationBackups
# How many automatic backups to keep (default 12 = about 3 months). Manual backups are kept until deleted.
# BACKUP_KEEP=12
